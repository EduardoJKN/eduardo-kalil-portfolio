---
import Layout from "../../layouts/Layout.astro";
const project = {"slug": "bi-comercial-reconecta", "title": "Reconstrução do BI Comercial — Reconecta", "subtitle": "Integração de fontes e padronização do funil comercial", "desc": "Reconstrução do BI de Marketing, Pré-vendas, Vendas e Pós-vendas, com consultas SQL, integração de fontes e dashboards em Streamlit e Looker Studio.", "impact": "Padronização das regras de leitura dos indicadores e investigação de divergências entre fontes e relatórios.", "categories": ["bi", "sql", "api"], "tags": ["Python", "PostgreSQL", "SQL", "Streamlit", "Looker Studio"], "context": "Informações de campanhas, formulários, CRM e pagamentos precisavam ser analisadas em conjunto. Diferenças de datas, duplicidades e atribuição dificultavam a comparação dos indicadores.", "solution": "Reconstrução das consultas e das visualizações, com revisão de filtros, regras de contagem e critérios de atribuição ao longo do funil comercial.", "steps": ["Análise e integração de fontes de marketing, formulários, CRM e pagamentos.", "Revisão de datas e fusos horários para alinhar os recortes dos relatórios.", "Tratamento de duplicidades e definição de regras de contagem.", "Desenvolvimento e evolução de dashboards em Streamlit e Looker Studio.", "Conferência de indicadores, detalhamentos e exportações."]};
---
<Layout title={`${project.title} — Eduardo Kalil`}>
  <section class="mx-auto w-full max-w-6xl px-6 py-14 space-y-12">
    <header class="space-y-5">
      <div class="flex flex-wrap gap-2">{project.tags.map((tag) => <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs text-zinc-700">{tag}</span>)}</div>
      <h1 class="max-w-4xl text-4xl font-extrabold tracking-tight text-zinc-900 md:text-5xl">{project.title}</h1>
      <p class="max-w-3xl text-base leading-7 text-zinc-600">{project.desc}</p>
      
      <a href="/projetos" class="inline-flex rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50">← Voltar para projetos</a>
    </header>
    <!-- portfolio-galeria-demo-v1 -->
    <section class="space-y-5" aria-label="Demonstração visual do projeto">
      <div class="space-y-2">
        <h2 class="text-2xl font-semibold text-zinc-900">Demonstração do projeto</h2>
        <p class="text-sm leading-6 text-zinc-600">Interfaces do projeto em ambiente de demonstração. Todos os dados apresentados são fictícios e não representam resultados reais. Clique nas imagens para ampliar em uma nova aba.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm md:col-span-2">
          <a href="/img/projetos/bi-comercial/01-visao-geral-vendas.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Visão geral de vendas com indicadores financeiros, conversão e receita mensal. (nova aba)">
            <img src="/img/projetos/bi-comercial/01-visao-geral-vendas.png" alt="Visão geral de vendas com indicadores financeiros, conversão e receita mensal. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Visão geral de vendas com indicadores financeiros, conversão e receita mensal.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/bi-comercial/02-one-page-executivo.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Visão executiva que reúne Marketing, Pré-vendas e Vendas. (nova aba)">
            <img src="/img/projetos/bi-comercial/02-one-page-executivo.png" alt="Visão executiva que reúne Marketing, Pré-vendas e Vendas. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Visão executiva que reúne Marketing, Pré-vendas e Vendas.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/bi-comercial/03-funil-comercial.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Tendências diárias de leads, aplicações, investimento, agendamentos e tipos de venda. (nova aba)">
            <img src="/img/projetos/bi-comercial/03-funil-comercial.png" alt="Tendências diárias de leads, aplicações, investimento, agendamentos e tipos de venda. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Tendências diárias de leads, aplicações, investimento, agendamentos e tipos de venda.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="grid gap-5 md:grid-cols-3">
      {[{title:'Contexto',text:project.context},{title:'Solução e contribuição',text:project.solution},{title:'Entrega',text:project.impact}].map((item) => <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold text-zinc-900">{item.title}</h2><p class="mt-3 text-sm leading-6 text-zinc-600">{item.text}</p></div>)}
    </section>
    <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900">Frentes de trabalho</h2>
      <ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-6 text-zinc-700">{project.steps.map((step) => <li>{step}</li>)}</ul>
    </section>
    <p class="text-sm leading-6 text-zinc-500">Relato de experiência profissional. As imagens foram capturadas em uma demonstração local com dados fictícios. Código e dados reais da empresa não são disponibilizados neste portfólio.</p>
  </section>
</Layout>
