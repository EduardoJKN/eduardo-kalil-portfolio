---
import Layout from "../../layouts/Layout.astro";
const project = {"slug": "procedimentos-estoque", "title": "Inteligência de Procedimentos e Estoque — HofOS", "subtitle": "Consumo de produtos e custos de materiais", "desc": "Participação no desenvolvimento de análises de procedimentos realizados, produtos consumidos, contatos atendidos e custos de materiais, com recortes por período e profissional.", "impact": "Visibilidade do consumo registrado e dos custos conhecidos, com identificação de lacunas nos registros.", "categories": ["bi", "sql"], "tags": ["PostgreSQL", "Prisma", "NestJS", "React", "TypeScript"], "context": "As informações de procedimentos e consumo de produtos precisavam ser reunidas para permitir análises por tipo de procedimento, produto e profissional.", "solution": "Participação na definição das métricas e na evolução da interface e das consultas, incluindo procedimentos sem produtos e distinguindo custos conhecidos de itens sem custo informado.", "steps": ["Ranking de procedimentos realizados no período.", "Análise dos produtos consumidos e dos contatos atendidos.", "Recortes por tipo de procedimento e profissional.", "Cálculo dos custos de materiais quando há custo unitário registrado.", "Identificação de itens sem custo e manutenção da interface em períodos sem dados."]};
---
<Layout title={`${project.title} — Eduardo Kalil`}>
  <section class="mx-auto w-full max-w-6xl px-6 py-14 space-y-12">
    <header class="space-y-5">
      <div class="flex flex-wrap gap-2">{project.tags.map((tag) => <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs text-zinc-700">{tag}</span>)}</div>
      <h1 class="max-w-4xl text-4xl font-extrabold tracking-tight text-zinc-900 md:text-5xl">{project.title}</h1>
      <p class="max-w-3xl text-base leading-7 text-zinc-600">{project.desc}</p>
      
      <a href="/projetos" class="inline-flex rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50">← Voltar para projetos</a>
    </header>
    <!-- portfolio-galeria-demo-v1 -->
    <section class="space-y-5" aria-label="Demonstração visual do projeto">
      <div class="space-y-2">
        <h2 class="text-2xl font-semibold text-zinc-900">Demonstração do projeto</h2>
        <p class="text-sm leading-6 text-zinc-600">Interfaces do projeto em ambiente de demonstração. Todos os dados apresentados são fictícios e não representam resultados reais. Clique nas imagens para ampliar em uma nova aba.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm md:col-span-2">
          <a href="/img/projetos/procedimentos-estoque/01-indicadores-ranking-procedimentos.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Indicadores de procedimentos, contatos atendidos e custos conhecidos, com ranking por tipo. (nova aba)">
            <img src="/img/projetos/procedimentos-estoque/01-indicadores-ranking-procedimentos.png" alt="Indicadores de procedimentos, contatos atendidos e custos conhecidos, com ranking por tipo. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Indicadores de procedimentos, contatos atendidos e custos conhecidos, com ranking por tipo.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/procedimentos-estoque/02-consumo-produtos.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Consumo de materiais por produto, com quantidades, custos e saldo cadastrado. (nova aba)">
            <img src="/img/projetos/procedimentos-estoque/02-consumo-produtos.png" alt="Consumo de materiais por produto, com quantidades, custos e saldo cadastrado. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Consumo de materiais por produto, com quantidades, custos e saldo cadastrado.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/procedimentos-estoque/03-consumo-profissionais.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Análise de procedimentos e custos conhecidos por profissional. (nova aba)">
            <img src="/img/projetos/procedimentos-estoque/03-consumo-profissionais.png" alt="Análise de procedimentos e custos conhecidos por profissional. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Análise de procedimentos e custos conhecidos por profissional.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="grid gap-5 md:grid-cols-3">
      {[{title:'Contexto',text:project.context},{title:'Solução e contribuição',text:project.solution},{title:'Entrega',text:project.impact}].map((item) => <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold text-zinc-900">{item.title}</h2><p class="mt-3 text-sm leading-6 text-zinc-600">{item.text}</p></div>)}
    </section>
    <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900">Frentes de trabalho</h2>
      <ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-6 text-zinc-700">{project.steps.map((step) => <li>{step}</li>)}</ul>
    </section>
    <p class="text-sm leading-6 text-zinc-500">Relato de experiência profissional. As imagens foram capturadas em uma demonstração local com dados fictícios. Código e dados reais da empresa não são disponibilizados neste portfólio.</p>
  </section>
</Layout>
