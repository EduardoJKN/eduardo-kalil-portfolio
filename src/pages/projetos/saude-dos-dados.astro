---
import Layout from "../../layouts/Layout.astro";
const project = {"slug": "saude-dos-dados", "title": "Saúde dos Dados com Python", "subtitle": "Monitoramento de qualidade e gestão de alertas", "desc": "Projeto desenvolvido em Python, com interface Streamlit e persistência em PostgreSQL, para identificar mudanças nas fontes e inconsistências que afetam os indicadores do BI.", "impact": "Estruturação de uma fila de alertas com histórico e silenciamentos para apoiar a investigação de inconsistências.", "categories": ["auto", "sql"], "tags": ["Python", "Streamlit", "PostgreSQL", "Qualidade de dados"], "context": "Uma nova categoria, campanha ou alteração na estrutura de origem pode deixar de ser contemplada pelas regras do BI sem gerar um erro visível no dashboard.", "solution": "Desenvolvimento de verificações em Python, com regras canônicas no código, uma interface de acompanhamento em Streamlit e armazenamento de alertas e histórico em PostgreSQL.", "steps": ["Verificação de classificações e categorias em relação às regras do BI.", "Identificação de mudanças em campanhas, volumes e estruturas de origem.", "Registro de alertas, histórico e silenciamentos em PostgreSQL.", "Organização da fila de investigação na interface Streamlit.", "Separação da execução das verificações em relação à interface."], "status": "Projeto em desenvolvimento durante minha atuação na Reconecta."};
---
<Layout title={`${project.title} — Eduardo Kalil`}>
  <section class="mx-auto w-full max-w-6xl px-6 py-14 space-y-12">
    <header class="space-y-5">
      <div class="flex flex-wrap gap-2">{project.tags.map((tag) => <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs text-zinc-700">{tag}</span>)}</div>
      <h1 class="max-w-4xl text-4xl font-extrabold tracking-tight text-zinc-900 md:text-5xl">{project.title}</h1>
      <p class="max-w-3xl text-base leading-7 text-zinc-600">{project.desc}</p>
      <p class="text-sm text-zinc-500">{project.status}</p>
      <a href="/projetos" class="inline-flex rounded-xl border border-zinc-200 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50">← Voltar para projetos</a>
    </header>
    <!-- portfolio-galeria-demo-v1 -->
    <section class="space-y-5" aria-label="Demonstração visual do projeto">
      <div class="space-y-2">
        <h2 class="text-2xl font-semibold text-zinc-900">Demonstração do projeto</h2>
        <p class="text-sm leading-6 text-zinc-600">Interfaces do projeto em ambiente de demonstração. Todos os dados apresentados são fictícios e não representam resultados reais. Clique nas imagens para ampliar em uma nova aba.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm md:col-span-2">
          <a href="/img/projetos/saude-dos-dados/01-visao-geral.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Visão geral dos alertas e das etapas do funil afetadas. (nova aba)">
            <img src="/img/projetos/saude-dos-dados/01-visao-geral.png" alt="Visão geral dos alertas e das etapas do funil afetadas. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Visão geral dos alertas e das etapas do funil afetadas.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/saude-dos-dados/02-fila-alertas.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Fila de achados com contexto, possível causa e ações de acompanhamento. (nova aba)">
            <img src="/img/projetos/saude-dos-dados/02-fila-alertas.png" alt="Fila de achados com contexto, possível causa e ações de acompanhamento. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Fila de achados com contexto, possível causa e ações de acompanhamento.</p>
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
          <a href="/img/projetos/saude-dos-dados/03-historico.png" target="_blank" rel="noopener noreferrer" class="block transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900" aria-label="Ampliar: Acompanhamento de alertas aceitos e histórico das verificações. (nova aba)">
            <img src="/img/projetos/saude-dos-dados/03-historico.png" alt="Acompanhamento de alertas aceitos e histórico das verificações. Dados fictícios." width="1680" height="1050" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <figcaption class="space-y-2 p-4">
            <span class="inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-2.5 py-1 text-xs font-medium text-zinc-700">Dados fictícios para demonstração</span>
            <p class="text-sm leading-6 text-zinc-600">Acompanhamento de alertas aceitos e histórico das verificações.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="grid gap-5 md:grid-cols-3">
      {[{title:'Contexto',text:project.context},{title:'Solução e contribuição',text:project.solution},{title:'Entrega',text:project.impact}].map((item) => <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold text-zinc-900">{item.title}</h2><p class="mt-3 text-sm leading-6 text-zinc-600">{item.text}</p></div>)}
    </section>
    <section class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900">Frentes de trabalho</h2>
      <ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-6 text-zinc-700">{project.steps.map((step) => <li>{step}</li>)}</ul>
    </section>
    <p class="text-sm leading-6 text-zinc-500">Relato de experiência profissional. As imagens foram capturadas em uma demonstração local com dados fictícios. Código e dados reais da empresa não são disponibilizados neste portfólio.</p>
  </section>
</Layout>
